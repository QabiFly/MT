# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Connection URL (e.g., postgresql://user:password@localhost:5432/tuition_db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tuition_db"

# Cloudinary Storage for student photos, doubt attachments, and documents
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Auth JWT Secret for signed sessions
JWT_SECRET="tuition-system-secure-jwt-key-2026"
